# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=nlp_root_password
MYSQL_DATABASE=nlp_db
MYSQL_USER=nlp_user
MYSQL_PASSWORD=nlp_password

# Database URL for SQLAlchemy (Used by API and Celery Worker)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://nlp_user:nlp_password@db:3306/nlp_db

# RabbitMQ / Celery Broker URL
# Format: amqp://<user>:<password>@<host>:<port>//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
